name: pkgdown

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]
  release:
    types: [ published ]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  pkgdown:
    uses: GregorLueg/personal-actions/.github/workflows/r-pkgdown.yml@v1
    with:
      rust: [[ ci_rust | lower ]]
[% if ci_rust and rust_toolchain != 'stable' %]
      rust-toolchain: '[[ rust_toolchain ]]'
[% endif %]
      gpu: [[ has_gpu | lower ]]
[% if not quarto %]
      # No vignettes in this package, so nothing to render with Quarto.
      quarto: false
[% endif %]
[% if extra_sysdeps %]
      extra-sysdeps: '[[ extra_sysdeps ]]'
[% endif %]
    secrets: inherit
